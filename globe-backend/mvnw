#!/bin/sh
# Maven Wrapper script
# Auto-downloads Maven if not found

set -e

MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-3.9.9"
MAVEN_BIN="${MAVEN_HOME}/bin/mvn"
DIST_URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.tar.gz"

if [ ! -f "${MAVEN_BIN}" ]; then
  echo "Downloading Maven 3.9.9..."
  mkdir -p "${MAVEN_HOME}"
  TMP_FILE=$(mktemp)
  curl -sL "${DIST_URL}" -o "${TMP_FILE}"
  tar xzf "${TMP_FILE}" -C "${MAVEN_HOME}" --strip-components=1
  rm -f "${TMP_FILE}"
  echo "Maven 3.9.9 installed."
fi

MAVEN_OPTS="${MAVEN_OPTS}" exec "${MAVEN_BIN}" "$@"
